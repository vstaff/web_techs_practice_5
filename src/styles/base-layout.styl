@require mixins

img.page-logo__logo 
    display block 
    max-width 100%

header.page-header 
    padding 0.5rem
    display grid 
    grid-template-columns 56px calc(100% - 56px)
    align-items center 
    height 67px
    makeSticky(0)
    z-index 100
    background-color: rgb(9, 9, 11)

    img.page-logo__logo
        background-color whitesmoke
        padding: 0 0.25rem
        border-radius 1rem



.page-navigation
    display flex 
    flex-flow row wrap 
    align-items center 
    justify-content flex-end

    gap 1rem

    &__link
        display inline-block
        color white 
        text-decoration none 

        &:hover
            box-shadow 2px 2px 0 red

        &_active 
            text-decoration underline

main, footer
    padding 1.5rem

footer.page-footer>p.page-footer__paragraph
    width 100%
    text-align center