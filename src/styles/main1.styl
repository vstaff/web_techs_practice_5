back(size)
    padding: size + "%"
    margin 0 0 1% 0

colorText = #000000
html
 color colorText

sidebarStyle(position_c, position_r, border_side)
    grid-column position_c
    grid-row position_r
    border-{border_side} 3px solid black
    if border_side == 'right'
        text-align right
    else
        text-align left
    img 
        width 35%
        if border_side == 'right'
            float right
        else
            float left
        margin 0px 10px 0px 10px
nav
    back(0)
    text-align center
    border 1px solid #ccc
    border-radius 4px
    & a
        display inline-block
        padding 10px
        margin 10px
        color #888
        text-decoration none
        border-radius 4px

        &:hover
            color white
            background-color cornflowerblue
        &.active
            background-color #6b9aff
            color #fff

.gallery
    display grid
    grid-template-columns 1fr 2fr
    grid-template-rows 1fr 1fr 1fr
    gap 8px
    height 300px
    width 100%
    

    &__png1_top
        grid-column 1
        grid-row 1
        overflow hidden

    &__png1_bottom
        grid-column 1
        grid-row 2
        border-radius 4px
        overflow hidden

    &__png2
        grid-column 2
        grid-row 1 / 3
        border-radius 4px
        overflow hidden

    &__png3
        grid-column 1 / -1
        grid-row 3
        border-radius 4px
        overflow hidden
    

    img
        width 100%
        height 100%
        display block
    @media (max-width: 1000px)
        grid-template-columns 1fr
        grid-template-rows 1fr 1fr 1fr 1fr
        &__png2
            grid-column 1
            grid-row 1
        &__png1_top
            grid-row 2
        &__png1_bottom
            grid-row 3
        &__png3
            grid-row 4

.grid-center
    display grid
    grid-template-columns 1fr 3fr 1fr 
    grid-template-rows 1fr 1fr 1fr
    width 100%
    height 600px
    gap 0

    p
        height 100%
        margin 10px 0px 10px 0px

    &__left-top
        grid-column 1
        grid-row 1 / 3
        border-right 3px solid black
        text-align right
        img 
            width 35%
            float right
            margin 0px 10px 0px 10px

    
    &__left-bottom
        grid-column 1
        grid-row 3
        border-right 3px solid black
        text-align right
        img 
            width 35%
            float right
            margin 0px 10px 0px 10px
    
    &__center-top
        grid-column 2
        grid-row 1
        text-align center
    &__center-bottom
        display flex
        grid-column 2
        grid-row 2/4
        justify-content center
        gap 10px
        margin 10px
        .container
            
            padding 5px
            text-align center
            border 2px solid palevioletred
            border-radius 5px
            a
                float right
                color orange
                text-decoration underline
            img
                width 60%
                height 50px
                border-radius 15px
                float none

    &__right-top
        grid-column 3
        grid-row 1
        border-left 3px solid black
        text-align left
        
        img 
            width 35%
            float left
            margin 0px 10px 0px 10px

    &__right-bottom
        grid-column 3
        grid-row 2 / 4
        border-left 3px solid black
        text-align left

        img 
            width 35%
            float left
            margin 0px 10px 0px 10px
        
    &__left-top,
    &__right-top,
    &__left-bottom,
    &__right-bottom
        input[type="button"]
            background-color #2e6ecf 
            color white
            border 1px solid black
            border-radius 5px
            font-size 14px
    @media (max-width: 1000px)
        grid-template-columns 1fr
        grid-template-rows 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr
        height 1800px      
 
        &__center-top
            grid-column 1
            grid-row 4

        &__center-bottom
            flex-wrap wrap
            grid-column 1
            grid-row 5/11

        &__right-top
            grid-column 1
            grid-row 11

        &__right-bottom
            grid-column 1
            grid-row 12/14


img.img1
    height 389px
    clear both
    @media (max-width: 1000px)
        height 80%

img.img2
    height 189px
    clear both
    @media (max-width: 1000px)
        height 60%
footer
    background-color lightgrey
    height 30px

img.big
    margin auto
    display block
    max-width 700px