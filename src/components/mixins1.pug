mixin createMenu(menu, active)
    each value, key in menu
        if active == key
            a.active(href= value)= key
        else
            a(href= value)= key

mixin createMenuGame(menu, active)
    each value, key in menu
        if key == "Топ компьютерных игр"
            a(href= value)= key
            a.active(href= "#")= active
        else
            a(href= value)= key

mixin gameBlock(text, imgClass)
    p
        img(src=require("../images/super_mario_galaxy_2.png") class=imgClass)
        b= title1
        br
        br
        |#{text}
        br
        input(type="button" value="Подробнее >>")
    
mixin container()
    .container
        p 
            img(src=require("../images/GTA4.png"))
            br
            b Grand Theft Auto IV (сокр. GTA IV)
            br
            |#{ddd2}
            br
            a Подробнее

mixin gameRow(game)
    tr
        each name in game
            td= name

mixin gameTable(head, games)
        table(border="2" cellspacing="0" cellpadding="5")
            thead
                tr
                    each header in head
                        th= header
            tbody(align="left")
                each game in games
                    +gameRow(game)

mixin make_level(name, options_list, checkbox_value)
    label #{name}: 
        select(name=name)
            each option in options_list
                if option.value == 0
                    option(value=option.value, selected) #{option.text}
                else
                    option(value=option.value) #{option.text}
    span  по убыванию?
    input(type="checkbox", name="reverse", value=checkbox_value)
    br  

