extends ../templates/base-layout

mixin makeGraphicSettings(oxLegend, oxInputs, oyLegend, oyInputs)
    details.graphic-settings-wrapper
        summary График
        form(action='#').graphic-settings-wrapper__form
            fieldset.graphic-settings-wrapper__ox-fieldset 
                legend #{oxLegend}

                each item in oxInputs 
                    div.graphic-settings-wrapper__setting-row
                        label(for=item.id)=item.placeholder 
                        input(placeholder=item.placeholder, id=item.id, name=item.name, type=item.type, value=item.value).graphic-settings-wrapper__ox-input

            fieldset.graphic-settings-wrapper__oy-fieldset 
                legend #{oyLegend}

                each item in oyInputs 
                    div.graphic-settings-wrapper__setting-row 
                        label(for=item.id)=item.placeholder 
                        input(placeholder=item.placeholder, id=item.id, name=item.name, type=item.type, value=item.value).graphic-settings-wrapper__oy-input

            input(type="submit" value="Построить").graphic-settings-wrapper__submit

mixin makeFilters(filters)
    details.filters-wrapper
        summary.filters-wrapper__summary Фильтры 
        form(action="#").filters
            each item in filters
                input(placeholder=item.placeholder, id=item.id, name=item.id, type=item.type).filters__input

            input(type="submit" value="Найти")

mixin makeSorting(sortingOptions)
    details.sorting-wrapper 
        summary.sorting-wrapper__summary Сортировка
        form(action="#").sorting 
            - for (let i = 1; i < 4; ++i)
                p.sorting__level
                    label(for=`level_${i}`) Уровень #{i}
                    select(id=`level_${i}` name=`level_${i}`)
                        each item in sortingOptions
                            option(value=`level_${i}_${item.name}`)=item.label 

            input(type="submit" value="Подтвердить").sorting__submit

mixin makeTable(headers, content)
    table.chart
        thead.chart__head
            tr.chart__head-row
                each item in headers  
                    th.chart__header #{item.label}

        tbody.chart__body
            each item in content 
                tr.chart__body-row 
                    each field in item 
                        td.chart__cell #{field}

